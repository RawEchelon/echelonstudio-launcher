{
  "name": "echelonstudio-launcher",
  "version": "1.0.0",
  "description": "EchelonStudio - Minecraft Launcher for FroziaMc and DrakkarMC",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run build && concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "client": "vite",
    "server": "node server/index.js",
    "electron": "npm run build && electron .",
    "electron:build": "electron-builder",
    "electron:dist": "npm run build && electron-builder --publish=never"
  },
  "keywords": ["minecraft", "launcher", "frozia", "drakkar", "electron"],
  "author": "RawEchelon",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "vite": "^5.0.0",
    "typescript": "^5.0.2"
  }
}
